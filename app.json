{
  "expo": {
    "name": "vibecode",
    "slug": "vibecode",
    "scheme": "routeshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "react-native-maps",
        {
          "useGoogleMaps": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibecode.routeshare",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby drivers and track your trips."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.vibecode.routeshare"
    }
  }
}
